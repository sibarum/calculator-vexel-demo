{
  "id": "calculator",
  "name": "Calculator",
  "publisher": "sibarum",
  "description": "A small calculator window onto cott-engine.",
  "version": "0.1.2-SNAPSHOT",

  "repo": "sibarum/vexelray-dist",
  "branch": "main",
  "repoPath": "apps/calculator",
  "releasesRepo": "sibarum/vexelray-dist",
  "tagFormat": "calculator-v{version}",

  "windows": {
    "binaries": [
      {
        "name": "calculator",
        "source": "target/calculator.exe",
        "icon": "src/main/rc/calculator.ico",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "Calculator" }
      },
      {
        "name": "calculator-ffmpeg-record",
        "source": "target/calculator-ffmpeg-record-windows-x86_64.zip",
        "dir": "ffmpeg-record"
      },
      { "name": "notices", "source": "THIRD-PARTY-NOTICES.txt" }
    ]
  },

  "linux": {
    "binaries": [
      {
        "name": "calculator",
        "appId": "dev.vexelray.demo.calculator-vexel-demo",
        "source": "target-linux/calculator",
        "icon": "src/main/rc/calculator.ico",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "Calculator" }
      },
      {
        "name": "calculator-ffmpeg-record",
        "source": "target-linux/calculator-ffmpeg-record-linux-x86_64.tar.gz",
        "dir": "ffmpeg-record"
      },
      { "name": "notices", "source": "THIRD-PARTY-NOTICES.txt" }
    ]
  }
}
