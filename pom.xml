<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.demo</groupId>
    <artifactId>calculator-vexel-demo</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>calculator-vexel-demo</name>
    <description>
        A deceptively simple calculator built on vexelray-gui. Standalone client app: depends on the
        framework from the local Maven repo and selects its platform modules via OS-activated profiles,
        the same shape as vexelray-gui-demo.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-gui.version>0.1.0-SNAPSHOT</vexelray-gui.version>
        <vexelray.version>0.1.0-SNAPSHOT</vexelray.version>
        <tactroller.version>1.0-SNAPSHOT</tactroller.version>
        <cott-engine.version>0.1.0-SNAPSHOT</cott-engine.version>
        <mainframe.version>0.1.0-SNAPSHOT</mainframe.version>

        <app.mainClass>dev.vexelray.demo.calculator.CalculatorApp</app.mainClass>
        <!-- Program args for exec:exec (one token; empty = interactive). -->
        <!-- Diagnostics: mvn compile exec:exec "-Dwake.trace=true" traces every frame-loop wake. -->
        <wake.trace>false</wake.trace>

        <!--
          Profiling: verbose on demand, across the whole stack. See sibarum.probe.Probe.

            mvn compile exec:exec -Pprofiler                       everything, rollup every 2s, slow frames named
            mvn compile exec:exec "-Dprobe=frame,gpu"              two lanes only
            mvn compile exec:exec -Pprofiler "-Dprobe.out=run.log" to a file instead of stdout

          Lanes: bus state time anim input frame layout draw gpu shader app.

          Every one of these is also an environment variable — PROBE, PROBE_OUT, PROBE_TRACE, PROBE_EVERY,
          PROBE_SLOW, PROBE_STACKS — which is the form that works identically on every OS, survives into the
          native-image binary built by the `native` profile below (there is no JVM there to pass -D to), and
          does not need Maven at all.
        -->
        <probe>off</probe>
        <probe.out></probe.out>
        <probe.trace>false</probe.trace>
        <probe.every>0</probe.every>
        <probe.slow>0</probe.slow>
        <probe.stacks>false</probe.stacks>
        <probe.format>text</probe.format>
        <!-- The automation driver: "off", "on" for the default port, or a port number. -->
        <automation>off</automation>
        <app.args></app.args>
        <app.args2></app.args2>
        <app.args3></app.args3>
    </properties>

    <dependencies>
        <!-- Driving the running app the way a person does: real window, real Vulkan, real frame loop.
             A troubleshooting instrument, not a shipped feature - see vexelray-gui/docs/automation.md. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The clock. Every window here attaches one, and the capture ticks them by hand: a picture of
             something in motion is a picture taken at a moment, and a moment is what this supplies. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The mathematics: COTT as a direct evaluator. Pure Java, no subprocess, no natives. -->
        <dependency>
            <groupId>sibarum.cott</groupId>
            <artifactId>cott-engine</artifactId>
            <version>${cott-engine.version}</version>
        </dependency>
        <!-- Input at the application edge: the tactroller->atchung bridge. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- MainFrame, and its console as a vexelray-gui component. Two arrangements of this calculator come
             out of it: CalculatorApp, the program that owns the loop, and CalculatorDesktop, where MainFrame
             owns it and the calculator is one of the things it opens. Brings mainframe-core, the shell library,
             in behind it. -->
        <dependency>
            <groupId>dev.mainframe</groupId>
            <artifactId>mainframe-vexel-gui</artifactId>
            <version>${mainframe.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <target>${maven.compiler.release}</target>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <!-- Run: mvn compile exec:exec ; headless capture: mvn compile exec:exec "-Dapp.args=[dash][dash]capture" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-Dvexelray.wake.trace=${wake.trace}</argument>
                        <argument>-Dprobe=${probe}</argument>
                        <argument>-Dprobe.out=${probe.out}</argument>
                        <argument>-Dprobe.trace=${probe.trace}</argument>
                        <argument>-Dprobe.every=${probe.every}</argument>
                        <argument>-Dprobe.slow=${probe.slow}</argument>
                        <argument>-Dprobe.stacks=${probe.stacks}</argument>
                        <argument>-Dprobe.format=${probe.format}</argument>
                        <argument>-Dautomation=${automation}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${app.mainClass}</argument>
                        <argument>${app.args}</argument>
                        <argument>${app.args2}</argument>
                        <argument>${app.args3}</argument>
                    </arguments>
                </configuration>
            </plugin>
            <!--
              This application's own glyph atlas, shadowing the one vexelray-text ships.

              GuiApp loads exactly one atlas, by the fixed classpath name
              /dev/vexelray/text/atlas/primary.{json,png}. Writing ours to that path under
              src/main/resources puts the project's classes ahead of the dependency jar, so the
              calculator draws with the faces below and every other app keeps the framework's.

              Face 0 is STIX Two Math (OFL): a Times-cut serif — formal, and crisp at the sizes the
              keypad uses — that carries the mathematical operators, arrows, letterlike forms and
              bracket pieces the framework's Noto Sans does not have at all. The framework atlas asks
              for those blocks and gets one glyph out of 0x2200-0x22FF, because the charset was
              willing and the font was not; that is why the labels here were written around missing
              glyphs. Face 1 stays NotoSansMono-Regular at the same index the framework put it,
              because MainFrame's console addresses monospace as font(1) and this app is one of its
              guests (see CalculatorDesktop).

              Regenerated at generate-resources and committed, incrementally — the plugin re-runs
              only when a font is newer than the outputs. On non-Windows build with
              -Dmsdf.mode=prebuilt, which consumes the committed pair instead of regenerating.
            -->
            <plugin>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-msdf-maven-plugin</artifactId>
                <version>${vexelray.version}</version>
                <executions>
                    <execution>
                        <id>generate-atlases</id>
                        <goals>
                            <goal>generate-atlas</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputDir>${project.basedir}/src/main/resources/dev/vexelray/text/atlas</outputDir>
                    <atlases>
                        <atlas>
                            <name>primary</name>
                            <font>${project.basedir}/fonts/STIX/STIXTwoMath.ttf</font>
                            <!--
                              Latin through Latin Extended-A for text; Greek for the tokens the engine
                              actually reads back (pi, omega, theta); punctuation and the super/subscript
                              block; letterlike (script F on the caption); arrows; the whole of
                              mathematical operators; the four floor/ceiling corners; currency, of which
                              STIX has the eight that matter. About 990 glyphs — the framework's atlas
                              holds 1112 at this size, so this fits 2048 with room left.
                            -->
                            <charset>
[0x20, 0x7E]
[0xA0, 0xFF]
[0x100, 0x17F]
[0x370, 0x3FF]
[0x2000, 0x206F]
[0x2070, 0x209F]
[0x20A0, 0x20BF]
[0x2100, 0x214F]
[0x2190, 0x21FF]
[0x2200, 0x22FF]
[0x2308, 0x230B]
                            </charset>
                            <extraFonts>
                                <extraFont>
                                    <font>${project.basedir}/fonts/Noto_Sans_Mono/NotoSansMono-Regular.ttf</font>
                                    <charset>latin-1</charset>
                                </extraFont>
                            </extraFonts>
                            <atlasSize>2048</atlasSize>
                            <fontSize>32</fontSize>
                            <pxRange>4</pxRange>
                        </atlas>
                    </atlases>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <!--
          Run the application profiled: mvn compile exec:exec -Pprofiler

          A profile rather than six properties to remember, and the defaults are chosen to answer the first
          question rather than every question. All lanes, so nothing is missing on the run you did not plan;
          a rollup every two seconds, so a session that ends in a kill still left a report behind; and any
          frame over 16 ms named the moment it happens, because a stutter you can see in the window and a
          line you can see in the log are how a complaint becomes a measurement.

          Override any of it on the same command line — -Pprofiler "-Dprobe=gpu" narrows the lanes and keeps
          the rest, and "-Dprobe.out=run.log" sends it to a file. -Dprobe.trace=true adds a line per event,
          which is the setting to reach for once the rollup has told you which lane to stare at.
        -->
        <profile>
            <id>profiler</id>
            <properties>
                <probe>all</probe>
                <probe.every>2000</probe.every>
                <probe.slow>16</probe.slow>
                <probe.stacks>true</probe.stacks>
            </properties>
        </profile>
        <!-- Build-time platform selection, same as vexelray-gui-demo. -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!--
          mvn -Pnative package  ->  target/calculator.exe

          The switches are the ones mainframe-dist found the hard way, and each is load-bearing. This is the
          calculator on its own; the same program also ships inside mainframe.exe, where dist names them again
          because a profile does not travel with a dependency.

          What native-image needs to know beyond the switches is in src/main/resources/META-INF/native-image:
          the tracing agent output dist was built from, less the parts that are only the editor's - the
          TextMate grammars, joni's Unicode tables, TM4E's Raw* grammar classes and the file-dialog
          library. dist's second file, the X.509 machinery a *signed* jar drags into the image heap, is
          absent for the same reason: TM4E is that jar, and nothing on this classpath is signed.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <!-- native-image compiles small probe executables and runs them to measure the
                             platform. Windows Application Control blocks a brand-new unsigned .exe under
                             %TEMP%, so the probes are pointed at target/nitmp instead, which this creates. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>make-native-temp-dir</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/nitmp"/>
                                    </target>
                                </configuration>
                            </execution>
                            <!-- The executable's own icon, which is a packaging fact rather than an engine
                                 one: what Explorer shows for calculator.exe, what a pinned shortcut shows
                                 before the program runs, and - because VexelRay sets no AppUserModelID - what
                                 the taskbar button shows while it does. The running window's icon is the other
                                 half, and lives in Icons.java. Compiling .rc -> .res needs rc.exe on PATH,
                                 which the MSVC environment native-image already requires on Windows supplies;
                                 failonerror, because an icon that silently did not get linked looks exactly
                                 like one that was never asked for. -->
                            <execution>
                                <id>compile-exe-icon</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <exec executable="rc" failonerror="true">
                                            <arg value="/nologo"/>
                                            <arg value="/fo"/>
                                            <arg file="${project.build.directory}/calculator.res"/>
                                            <arg file="${project.basedir}/src/main/native/calculator.rc"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>calculator</imageName>
                            <mainClass>${app.mainClass}</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <!-- The graphics stack and both input backends are Panama downcalls, and Win32
                                     calls back in through an upcall stub for the window procedure. The
                                     signatures themselves are in reachability-metadata.json. -->
                                <buildArg>-H:+ForeignAPISupport</buildArg>
                                <!-- The input backend gives each raw-input registration its own Arena.ofShared,
                                     because the window procedure that reads it runs on a different thread from
                                     the one that opened it. Without this the application runs and then throws
                                     on the way out, when the backend closes them. -->
                                <buildArg>-H:+SharedArenaSupport</buildArg>
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>-J-Djava.io.tmpdir=${project.build.directory}/nitmp</buildArg>
                                <!-- No console window. native-image links a console-subsystem executable, so
                                     Windows hands the process a black terminal before anything runs - and
                                     because that console owns the process group, closing it kills the
                                     calculator. /ENTRY is not optional alongside it: /SUBSYSTEM:WINDOWS makes
                                     the linker look for WinMain, and the image's entry point is an ordinary
                                     main. Windows linker options; a native build elsewhere drops these two. -->
                                <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:WINDOWS</buildArg>
                                <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                                <!-- The compiled icon resource, handed to the linker like any other object.
                                     Built by the compile-exe-icon execution above; a Windows linker option
                                     too, so a native build elsewhere drops this along with the two before. -->
                                <buildArg>-H:NativeLinkerOption=${project.build.directory}/calculator.res</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
