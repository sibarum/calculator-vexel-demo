<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.demo</groupId>
    <artifactId>calculator-vexel-demo</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>calculator-vexel-demo</name>
    <description>
        A plot viewport built on vexelray-gui, and the reference implementation of a client application of
        that framework. Standalone: depends on the stack from the local Maven repo and selects its platform
        modules through OS-activated profiles, the same shape as vexelray-gui-demo. See docs/design.md.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-framework.version>0.1.0-SNAPSHOT</vexelray-framework.version>
        <vexelray-gui.version>0.1.0-SNAPSHOT</vexelray-gui.version>
        <vexelray.version>0.1.0-SNAPSHOT</vexelray.version>
        <tactroller.version>1.0-SNAPSHOT</tactroller.version>
        <junit.version>5.11.4</junit.version>

        <app.mainClass>dev.vexelray.demo.calculator.Calculator</app.mainClass>

        <!--
          Program args for exec:exec, split on whitespace by the commandlineArgs form below. Empty is the
          interactive run; a multi-word value is several arguments rather than one, which is what lets a run
          pass a frame count and a framework flag together rather than as one nonsense token.

          (No example here spells a framework flag out: a literal double dash cannot appear inside an XML
          comment, and writing one here is how this pom has been made non-parseable before.)
        -->
        <app.args></app.args>

        <!--
          Profiling: verbose on demand, across the whole stack. See sibarum.probe.Probe and atchung/docs/probe.md.
          Lanes: bus state time anim input frame layout draw gpu shader app.
        -->
        <probe>off</probe>
        <probe.out></probe.out>
        <probe.trace>false</probe.trace>
        <probe.every>0</probe.every>
        <probe.slow>0</probe.slow>
        <probe.stacks>false</probe.stacks>
        <probe.format>text</probe.format>

        <!-- The automation driver: "off", "on" for the default port, or a port number. -->
        <automation>off</automation>

        <!--
          Extra JVM flags for exec:exec, split on whitespace. Needed because a -D on the mvn command line sets a
          MAVEN property, which reaches the forked JVM only if the command line below names it: without this,
          "mvn exec:exec -Dplot.steps=48" runs the app with the default and reports a measurement of nothing.
          Found the hard way, by a performance sweep in which all seven configurations returned the same number.
        -->
        <app.jvmArgs></app.jvmArgs>
    </properties>

    <dependencies>
        <!-- The application framework: the edge this demo used to write for itself. Its -shell module
             owns the input backend, the clipboard, window memory, the frame loop and its pacing and
             wakes, the command line, and the ordered shutdown; what is left of this application's own
             wiring is in CalculatorWiring. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-shell</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- The driving socket, as a framework component. Its own module, so a binary that never
             wants to be driven does not link a listening socket. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-automation</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- The widget shelf, and the framework core and draw modules behind it. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The clock. Motion enters at the application edge and nowhere else: -widget declares seams shaped
             out of JDK types and this module satisfies them, so a widget animates without naming Kronometer. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Driving the running app the way a person does: real window, real Vulkan, real frame loop.
             A troubleshooting instrument, not a shipped feature - see vexelray-gui/docs/automation.md. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-automation</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The plot's geometry, as data: Surface.Stroke for the curve, the axes, the grid and the box, and
             Cones to hand that same chain out as numbers instead of compiling it into a shader. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-surface</artifactId>
            <version>${vexelray.version}</version>
        </dependency>
        <!-- The march that reads those numbers from a storage buffer, so the shader is the same bytes for
             every scene and a new expression is a buffer copy rather than a pipeline build. -->
        <dependency>
            <groupId>dev.vexelray</groupId>
            <artifactId>vexelray-technique-sdf</artifactId>
            <version>${vexelray.version}</version>
        </dependency>
        <!-- Input at the application edge: the tactroller->atchung bridge (brings tactroller-api and
             atchung-core transitively). The GUI core knows only the input topic contract. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- Standalone OS clipboard for the expression field; no input-subsystem coupling. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>${tactroller.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- A real GuiApp frame loop under a test's control: the one question no unit test can ask is
             whether a frame arrives on its own after a gesture. Needs a GPU, so these are local tests. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-harness</artifactId>
            <version>${vexelray-gui.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!--
              Run in a fresh JVM: mvn compile exec:exec
              exec:exec rather than exec:java so native access can be enabled for Panama FFM.

              One command line split on whitespace, rather than a list of argument elements. An argument
              element is exactly one token and a property cannot expand into several, so a multi-word
              app.args would arrive as a single argument and any two-argument run would be unrunnable as
              written. %classpath is substituted after the split, so it stays one argument even where a path
              contains a space.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <commandlineArgs>--enable-native-access=ALL-UNNAMED -Dstdout.encoding=UTF-8 -Dprobe=${probe} -Dprobe.out=${probe.out} -Dprobe.trace=${probe.trace} -Dprobe.every=${probe.every} -Dprobe.slow=${probe.slow} -Dprobe.stacks=${probe.stacks} -Dprobe.format=${probe.format} -Dautomation=${automation} ${app.jvmArgs} -classpath %classpath ${app.mainClass} ${app.args}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Run profiled: mvn compile exec:exec -Pprofiler

          Defaults chosen to answer the first question rather than every question: all lanes, a rollup every
          two seconds so a session ended by a kill still left a report behind, and any frame over 16 ms named
          the moment it happens. Override on the same command line - "-Dprobe=gpu" narrows the lanes and
          keeps the rest.
        -->
        <profile>
            <id>profiler</id>
            <properties>
                <probe>all</probe>
                <probe.every>2000</probe.every>
                <probe.slow>16</probe.slow>
                <probe.stacks>true</probe.stacks>
            </properties>
        </profile>

        <!-- Build-time platform selection: exactly one activates from the host OS, adding VexelRay's
             matching provider module and tactroller's input backend (both found by ServiceLoader). -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
