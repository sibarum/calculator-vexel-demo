target/
# The captures: regenerated by --capture, and a repo is not where a screenshot belongs.
*.png
# ...except the mark. These four are a resource the program loads at start-up, not a picture of it,
# and an icon that is not in the jar is a window with no icon. See Icons.java.
!src/main/resources/dev/vexelray/demo/calculator/*.png
.idea/
*.iml
# ...and except the glyph atlas, which is likewise a resource the program loads at start-up. It is
# generated at generate-resources and committed so a non-Windows build can consume it with
# -Dmsdf.mode=prebuilt rather than needing msdf-atlas-gen. See the pom's msdf plugin block.
!src/main/resources/dev/vexelray/text/atlas/primary.png
